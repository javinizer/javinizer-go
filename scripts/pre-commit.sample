#!/usr/bin/env bash
# pre-commit hook for javinizer-go
# Runs fast checks before allowing a commit
#
# Installation: cp scripts/pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# To skip this hook temporarily: git commit --no-verify

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

FORBIDDEN_PATHS=".planning/"

for path in $FORBIDDEN_PATHS; do
    if git diff --cached --name-only | grep -q "^${path}"; then
        echo -e "${RED}✗ Blocked: ${path} must not be committed (found in staged files)${NC}"
        exit 1
    fi
done

# Golangci-lint configuration
REQUIRED_VERSION_MAJOR=2
REQUIRED_VERSION_MINOR=4

# Resolve golangci-lint by preference: explicit $GOLANGCI_LINT override, then
# PATH, then ~/go/bin. PATH precedes ~/go/bin so a stale or toolchain-incompatible
# copy in ~/go/bin (e.g. reinstalled by a tooling sync) cannot shadow a working one.
resolve_golangci_lint() {
    if [[ -n "${GOLANGCI_LINT:-}" ]]; then
        return 0
    fi
    if command -v golangci-lint >/dev/null 2>&1; then
        GOLANGCI_LINT="$(command -v golangci-lint)"
        return 0
    fi
    GOLANGCI_LINT="${HOME}/go/bin/golangci-lint"
}

resolve_golangci_lint

# A golangci-lint build can only decode export data from Go toolchains up to
# its own build toolchain; an older build fails every typecheck against a newer
# Go installation. Detect that combination and skip with guidance rather than
# failing the commit on an environment problem.
golangci_lint_go_compat() {
    local lint_line lint_go tool_go
    lint_line=$("$GOLANGCI_LINT" version 2>&1 | head -1)
    lint_go=$(echo "$lint_line" | sed -nE 's/.*built with go([0-9]+\.[0-9]+).*/\1/p')
    tool_go=$(go version 2>/dev/null | sed -nE 's/^go version go([0-9]+\.[0-9]+).*/\1/p')
    [[ -z "$lint_go" || -z "$tool_go" ]] && return 0
    local lint_major lint_minor tool_major tool_minor
    IFS='.' read -r lint_major lint_minor <<< "$lint_go"
    IFS='.' read -r tool_major tool_minor <<< "$tool_go"
    if (( lint_major > tool_major )) || \
       (( lint_major == tool_major && lint_minor >= tool_minor )); then
        return 0
    fi
    return 1
}

echo -e "${BLUE}Running pre-commit checks...${NC}"
echo ""

# Function to check golangci-lint version
check_golangci_lint_version() {
    if [[ ! -x "$GOLANGCI_LINT" ]]; then
        return 1
    fi

    local version
    version=$("$GOLANGCI_LINT" version 2>&1)

    # Extract version number (e.g., "golangci-lint has version 2.4.0 built with...")
    # Use sed instead of grep -P for macOS compatibility
    local version_str
    version_str=$(echo "$version" | sed -nE 's/.*version ([0-9]+\.[0-9]+).*/\1/p')

    if [[ -z "$version_str" ]]; then
        return 1
    fi

    local major minor
    IFS='.' read -r major minor <<< "$version_str"

    if [[ -z "$major" || -z "$minor" ]]; then
        return 1
    fi

    if (( major > REQUIRED_VERSION_MAJOR )) || \
       (( major == REQUIRED_VERSION_MAJOR && minor >= REQUIRED_VERSION_MINOR )); then
        return 0
    fi

    return 1
}

# Check 1: Go formatting
echo -e "${BLUE}[1/8] Checking code formatting...${NC}"
UNFORMATTED=$(gofmt -l . 2>&1)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}✗ Code is not formatted. Please run 'make fmt'${NC}"
    echo "Unformatted files:"
    echo "$UNFORMATTED"
    exit 1
fi
echo -e "${GREEN}✓ Code formatting OK${NC}"
echo ""

# Check 2: golangci-lint
echo -e "${BLUE}[2/8] Running golangci-lint...${NC}"
if [[ -x "$GOLANGCI_LINT" ]] && check_golangci_lint_version; then
    if ! golangci_lint_go_compat; then
        echo -e "${YELLOW}⚠ $GOLANGCI_LINT is built with an older Go than the installed toolchain (skipping)${NC}"
        echo -e "${YELLOW}  Lint:   $("$GOLANGCI_LINT" version 2>&1 | head -1)${NC}"
        echo -e "${YELLOW}  Go:     $(go version)${NC}"
        echo -e "${YELLOW}  Fix:    reinstall golangci-lint built with >= $(go version | sed -E 's/^go version (go[0-9]+\.[0-9]+).*/\1/') or set GOLANGCI_LINT to a working binary${NC}"
    elif ! "$GOLANGCI_LINT" run ./... 2>&1; then
        echo -e "${RED}✗ golangci-lint found issues${NC}"
        exit 1
    else
        echo -e "${GREEN}✓ golangci-lint passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠ golangci-lint not installed or version too old (skipping)${NC}"
    echo -e "${YELLOW}  Required: >=${REQUIRED_VERSION_MAJOR}.${REQUIRED_VERSION_MINOR}.0${NC}"
    if [[ -x "$GOLANGCI_LINT" ]]; then
        echo -e "${YELLOW}  Current: $("$GOLANGCI_LINT" version 2>&1 | head -1)${NC}"
    fi
    echo -e "${YELLOW}  Install: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v${REQUIRED_VERSION_MAJOR}.x${NC}"
fi
echo ""

# Check 3: Go vet
echo -e "${BLUE}[3/8] Running go vet...${NC}"
if ! go vet ./... 2>&1; then
    echo -e "${RED}✗ go vet found issues${NC}"
    exit 1
fi
echo -e "${GREEN}✓ go vet passed${NC}"
echo ""

# Check 4: Fast unit tests (skip flaky network tests)
echo -e "${BLUE}[4/8] Running fast unit tests...${NC}"
# Increase timeout to 60s for the fast test pass
if ! go test -short -timeout=60s ./... 2>&1; then
    echo -e "${RED}✗ Tests failed${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Tests passed${NC}"
echo ""

# Check 5: Build verification
echo -e "${BLUE}[5/8] Verifying build...${NC}"
if ! go build -o /tmp/javinizer-test ./cmd/javinizer 2>&1; then
    echo -e "${RED}✗ Build failed${NC}"
    exit 1
fi
rm -f /tmp/javinizer-test
echo -e "${GREEN}✓ Build successful${NC}"
echo ""

# Check 6: Swagger documentation
echo -e "${BLUE}[6/8] Checking Swagger documentation...${NC}"
if ! command -v swag &> /dev/null; then
    echo -e "${YELLOW}⚠️  swag not installed, installing...${NC}"
    go install github.com/swaggo/swag/cmd/swag@latest
fi
export PATH=$PATH:$(go env GOPATH)/bin
if ! make swagger &> /dev/null; then
    echo -e "${RED}✗ Swagger generation failed${NC}"
    exit 1
fi
if ! git diff --quiet -- docs/swagger/; then
    echo -e "${RED}✗ Swagger documentation is out of date${NC}"
    echo -e "${YELLOW}Run 'make swagger' and commit the changes${NC}"
    echo ""
    git status docs/swagger/
    exit 1
fi
echo -e "${GREEN}✓ Swagger documentation up to date${NC}"
echo ""

# Check 7: Frontend Prettier formatting (only staged frontend files)
# Collect staged frontend files that prettier can parse. Excludes deletions
# (diff-filter=d) so a staged delete of a TS file doesn't trip prettier.
# *.svelte is Prettier-ignored at the config level (svelte-check covers it)
# — see web/frontend/.prettierignore.
FRONTEND_FMT_FILES=$(git diff --cached --name-only --diff-filter=d \
    | grep -E '^web/frontend/.*\.(ts|js|cjs|mjs|json|css|html|md|yaml|yml)$' || true)
if [ -n "$FRONTEND_FMT_FILES" ]; then
    echo -e "${BLUE}[7/8] Checking frontend formatting (prettier)...${NC}"
    if [ -d "web/frontend/node_modules" ]; then
        # prettier resolves .prettierrc/.prettierignore relative to its CWD,
        # so run from web/frontend. Map repo-relative paths to frontend-relative.
        # The xargs -r guard prevents running prettier with zero args (which
        # would otherwise check ALL files, masking the staged-only intent).
        if ! (cd web/frontend && \
              echo "$FRONTEND_FMT_FILES" | sed 's|^web/frontend/||' | \
              xargs -r npx prettier --check 2>&1); then
            echo -e "${RED}✗ Frontend formatting check failed${NC}"
            echo -e "${YELLOW}Run 'cd web/frontend && npm run format' and re-stage${NC}"
            exit 1
        fi
        echo -e "${GREEN}✓ Frontend formatting OK${NC}"
    else
        echo -e "${YELLOW}⚠ Frontend dependencies not installed, skipping prettier check${NC}"
    fi
else
    echo -e "${BLUE}[7/8] Frontend formatting${NC} (skipped — no staged frontend files)"
fi
echo ""

# Check 8: Frontend type checking (only if frontend src files changed)
FRONTEND_CHANGED=$(git diff --cached --name-only | grep -c "^web/frontend/src/" || true)
if [ "$FRONTEND_CHANGED" -gt 0 ]; then
    echo -e "${BLUE}[8/8] Running frontend type check (svelte-check)...${NC}"
    if [ -d "web/frontend/node_modules" ]; then
        if ! (cd web/frontend && npx svelte-check --threshold error) 2>&1; then
            echo -e "${RED}✗ Frontend type check failed${NC}"
            exit 1
        fi
        echo -e "${GREEN}✓ Frontend type check passed${NC}"
    else
        echo -e "${YELLOW}⚠ Frontend dependencies not installed, skipping type check${NC}"
    fi
else
    echo -e "${BLUE}[8/8] Frontend type check${NC} (skipped — no frontend changes)"
fi
echo ""

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}All pre-commit checks passed!${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "${YELLOW}Tip: Run 'make swagger' if you modified handler files${NC}"
echo -e "${YELLOW}Tip: Run 'make coverage-check' before pushing to ensure coverage threshold is met${NC}"
echo -e "${YELLOW}Tip: Run 'cd web/frontend && npm run format' before staging frontend changes${NC}"

exit 0
