{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true vite dev",
		"build": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true vite build",
		"preview": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true vite preview",
		"prepare": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true svelte-kit sync || echo '' && npx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true svelte-kit sync && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true svelte-kit sync && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true vitest run",
		"test:watch": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true vitest",
		"test:e2e": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true playwright test",
		"test:e2e:ui": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true playwright test --ui",
		"test:e2e:debug": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=true playwright test --debug",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/postcss": "^4.1.16",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.6.0",
		"@vitest/ui": "^4.1.2",
		"autoprefixer": "^10.4.21",
		"cross-env": "^10.1.0",
		"jsdom": "^29.0.1",
		"postcss": "^8.5.6",
		"prettier": "^3.8.4",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.16",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@inlang/paraglide-js": "2.21.0",
		"@inlang/plugin-message-format": "4.4.0",
		"@tanstack/svelte-query": "^6.1.24",
		"clsx": "^2.1.1",
		"fast-deep-equal": "^3.1.3",
		"lucide-svelte": "^0.562.0",
		"tailwind-merge": "^3.3.1"
	},
	"allowScripts": {
		"esbuild@0.27.2": true
	}
}
